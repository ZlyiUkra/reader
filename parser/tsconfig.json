{
  "compilerOptions": {
    "module": "nodenext",
    "target": "es2024",
    "noEmit": true,
    "strict": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "fixtures"],
  "exclude": ["node_modules"]
}
