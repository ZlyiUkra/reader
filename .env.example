# Copy to .env and replace the placeholders. .env is never committed and never printed.
# Superuser password of the database container (only the db service sees it).
POSTGRES_PASSWORD=replace-with-a-long-random-value
# Password of the non-superuser role "app" that the application connects with.
APP_DB_PASSWORD=replace-with-another-long-random-value
# Folder with the documents to read, relative to compose.yaml unless absolute.
READER_INBOX=./inbox
# Host port of the user interface; it is published on 127.0.0.1 only.
READER_PORT=3000
# Model tag served by the model container and fetched by model-pull.
MODEL_TAG=qwen3.5:4b
# User and group the fixtures generator runs as, so the files it writes into the inbox belong to you.
# Use the output of `id -u` and `id -g`.
READER_UID=1000
READER_GID=1000
