{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader.local/contracts/thresholds.v1.json",
  "title": "Thresholds file (C13): every tunable value, each marked provisional until the evaluation measures it",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "values"],
  "properties": {
    "version": { "const": 1 },
    "values": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model.num_ctx", "model.num_predict_extract", "model.num_predict_classify", "model.client_timeout_s",
                   "model.keep_alive", "model.chars_per_token", "parser.convert_timeout_s", "parser.render_timeout_s_per_page",
                   "parser.ocr_timeout_s_per_page", "parser.page_cap", "parser.ocr_dpi", "parser.render_width_px",
                   "parser.manifest_max_bytes", "parser.png_max_bytes", "parser.png_max_side_px", "parser.text_max_bytes",
                   "parser.tool_memory_mb", "intake.upload_max_bytes", "quality.ocr_low_confidence", "quality.ocr_low_share",
                   "quality.empty_min_chars", "quality.scanned_page_max_chars", "run.bound_minutes", "ui.preview_width_px",
                   "ui.poll_interval_ms", "eval.pass_required_match", "eval.max_false_accepts", "eval.ceiling_tokens_per_document",
                   "eval.ceiling_seconds_per_page_warm"],
      "patternProperties": {
        "^[a-z]+\\.[a-z_]+$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "unit", "status", "source"],
          "properties": {
            "value": { "type": ["number", "string"] },
            "unit": { "type": "string" },
            "status": { "enum": ["provisional", "measured"] },
            "source": { "type": "string", "minLength": 1 },
            "measuredAt": { "type": "string", "format": "date" }
          }
        }
      }
    }
  }
}
