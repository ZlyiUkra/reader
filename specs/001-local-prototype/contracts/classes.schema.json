{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader.local/contracts/classes.v1.json",
  "title": "Sensitivity classes (C2): the closed list; every class states whether its content may leave the machine",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "classes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "may_leave",
          "description"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z_]*$"
          },
          "may_leave": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
