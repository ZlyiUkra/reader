{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader.local/contracts/reasons-file.v1.json",
  "title": "Reasons file",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "reasons"],
  "properties": {
    "version": { "const": 1 },
    "reasons": {
      "type": "array",
      "minItems": 15,
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "outcome", "emitted", "emittedBy", "trigger", "params", "templates"],
        "properties": {
          "code": { "enum": ["ENCRYPTED", "CORRUPT", "MALWARE", "TOO_LARGE", "UNSUPPORTED_FORMAT", "DUPLICATE",
                             "LOW_OCR_QUALITY", "UNKNOWN_DOC_TYPE", "MISSING_REQUIRED_FIELD", "VALIDATION_FAILED",
                             "LOW_CONFIDENCE", "EMPTY", "INTERNAL_ERROR", "EXTRACTORS_DISAGREE", "TEXT_LAYER_MISMATCH"] },
          "outcome": { "enum": ["REJECTED", "QUARANTINED", "NEEDS_REVIEW", "RETRY", "DUPLICATE"] },
          "emitted": { "type": "boolean" },
          "emittedBy": { "type": "array", "items": { "enum": ["intake", "parse", "classify", "extract", "check", "worker"] } },
          "trigger": { "type": "string", "minLength": 1 },
          "params": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "kind"],
              "properties": { "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                              "kind": { "enum": ["string", "integer", "number", "date"] } }
            }
          },
          "templates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["uk", "en"],
            "properties": { "uk": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
          },
          "variants": {
            "description": "Alternative templates chosen by the stored params: the first variant whose `when` entries all equal the params wins; the base template and params apply when none matches. VALIDATION_FAILED uses it: its base template is the missing fragment, its variants are the registry checks.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["when", "params", "templates"],
              "properties": {
                "when": { "type": "object", "minProperties": 1, "additionalProperties": { "type": ["string", "integer", "boolean"] } },
                "params": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["name", "kind"],
                    "properties": { "name": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]*$" },
                                    "kind": { "enum": ["string", "integer", "number", "date"] } }
                  }
                },
                "templates": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["uk", "en"],
                  "properties": { "uk": { "type": "string", "minLength": 1 }, "en": { "type": "string", "minLength": 1 } }
                }
              }
            }
          }
        }
      }
    }
  }
}
