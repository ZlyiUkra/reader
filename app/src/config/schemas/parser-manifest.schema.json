{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reader.local/contracts/parser-manifest.v1.json",
  "title": "Parser job manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "jobId", "detectedMime", "converter", "pageCount", "pages", "timingsMs", "limitsHit"],
  "properties": {
    "version": { "const": 1 },
    "jobId": { "type": "string", "pattern": "^[a-z0-9]{32}$" },
    "detectedMime": { "type": "string", "maxLength": 128 },
    "converter": { "type": ["string", "null"], "maxLength": 64 },
    "pageCount": { "type": "integer", "minimum": 0, "maximum": 50 },
    "pages": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "source", "engine", "engineVersion", "dpi", "widthPx", "heightPx", "ocrWordsTotal", "ocrWordsLow", "timingsMs"],
        "properties": {
          "n": { "type": "integer", "minimum": 1, "maximum": 50 },
          "source": { "enum": ["text_layer", "ocr"] },
          "engine": { "type": "string", "maxLength": 32 },
          "engineVersion": { "type": "string", "maxLength": 32 },
          "dpi": { "type": ["integer", "null"], "minimum": 72, "maximum": 600 },
          "widthPx": { "type": "integer", "minimum": 1, "maximum": 4000 },
          "heightPx": { "type": "integer", "minimum": 1, "maximum": 8000 },
          "ocrWordsTotal": { "type": ["integer", "null"], "minimum": 0 },
          "ocrWordsLow": { "type": ["integer", "null"], "minimum": 0 },
          "timingsMs": {
            "type": "object",
            "additionalProperties": false,
            "required": ["render", "text", "ocr"],
            "properties": {
              "render": { "type": "integer", "minimum": 0 },
              "text": { "type": "integer", "minimum": 0 },
              "ocr": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "timingsMs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["detect", "convert", "pdfinfo", "total"],
      "properties": {
        "detect": { "type": "integer", "minimum": 0 },
        "convert": { "type": "integer", "minimum": 0 },
        "pdfinfo": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "limitsHit": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 64 } }
  }
}
