{
  "name": "reader-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Reader: API, worker and static front in one process (local prototype)",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "test": "node --test",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "node src/main.ts",
    "eval": "node src/eval.ts"
  },
  "dependencies": {
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.6",
    "@fastify/static": "10.1.8",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.7",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vite": "8.3.5"
  }
}
